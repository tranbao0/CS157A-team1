<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- shared top bar for every JSP page, goes inside <header class="site-header"> --%>
<%-- page sets request attribute navPage first ("home", "catalog", "progress", "profile", "auth" or "error") so right nav item shows as current, page without nav item (like roadmap) sets its own name and none shows as current --%>
<%-- c:out escapes email, so stored address cant inject tags into page --%>
<div class="topbar">
	<a class="topbar__brand" href="${pageContext.request.contextPath}/">CourseCraft</a>
	<nav class="topbar__nav" aria-label="Main">
<c:choose>
	<c:when test="${navPage == 'catalog'}">
		<a class="nav-link is-active" aria-current="page" href="${pageContext.request.contextPath}/catalog.jsp">Catalog</a>
	</c:when>
	<c:otherwise>
		<a class="nav-link" href="${pageContext.request.contextPath}/catalog.jsp">Catalog</a>
	</c:otherwise>
</c:choose>
<c:choose>
	<c:when test="${navPage == 'progress'}">
		<a class="nav-link is-active" aria-current="page" href="${pageContext.request.contextPath}/progress">My progress</a>
	</c:when>
	<c:otherwise>
		<a class="nav-link" href="${pageContext.request.contextPath}/progress">My progress</a>
	</c:otherwise>
</c:choose>
	</nav>
<%-- sign-in page has its own forms, so no account buttons there --%>
<c:if test="${navPage != 'auth'}">
	<div class="topbar__actions">
	<c:choose>
		<c:when test="${not empty sessionScope.email}">
		<span class="topbar__user">Signed in as <c:out value="${sessionScope.email}"/></span>
		<a class="btn btn--ghost" href="${pageContext.request.contextPath}/profile"<c:if test="${navPage == 'profile'}"> aria-current="page"</c:if>>Profile</a>
		<%-- form not link, LogoutServlet only accepts POST --%>
		<form method="post" action="${pageContext.request.contextPath}/logout">
			<button type="submit" class="btn btn--ghost">Sign out</button>
		</form>
		</c:when>
		<c:otherwise>
		<a class="btn btn--ghost" href="${pageContext.request.contextPath}/login">Sign in</a>
		<a class="btn btn--primary" href="${pageContext.request.contextPath}/register">Create account</a>
		</c:otherwise>
	</c:choose>
	</div>
</c:if>
</div>
