<%-- decorative art behind catalog's right column, sits inside sticky rail so it travels with search and cards --%>
<%--
  Blue disc with two rings rises over search like sun, glass cards frost rest of it.
  Box starts 128px above stack (art y 128 = search top) and ends long before stack bottom, so it never adds scroll.
  Stars and drifting dots stay in open space above search, away from card edges, so none reads as smudge.
  That space hides under glass header at page top, so they show only once header slides away (app.css section 17).
--%>
<svg class="rail-art" viewBox="0 0 404 400" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="rail-disc" cx="50%" cy="50%" r="50%">
      <%-- stop colors come from tokens in app.css section 17 --%>
      <stop class="rail-art__stop rail-art__stop--core" offset="0"/>
      <stop class="rail-art__stop rail-art__stop--mid" offset=".65"/>
      <stop class="rail-art__stop rail-art__stop--edge" offset="1"/>
    </radialGradient>
  </defs>

  <circle cx="196" cy="200" r="196" fill="url(#rail-disc)"/>
  <circle class="rail-art__ring" cx="196" cy="200" r="112"/>
  <circle class="rail-art__ring" cx="196" cy="200" r="160"/>

  <g class="art-motes">
    <circle class="art-mote art-mote--amber" cx="120" cy="96" r="3"/>
    <circle class="art-mote art-mote--sjsu art-mote--late" cx="262" cy="84" r="3"/>
    <circle class="art-mote art-mote--blue" cx="150" cy="26" r="4"/>
  </g>
  <g class="art-sparks">
    <g transform="translate(70 70) scale(.7)"><path class="art-spark" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
    <g transform="translate(196 62) scale(.5)"><path class="art-spark art-spark--3" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
    <g transform="translate(320 50) scale(.9)"><path class="art-spark art-spark--2" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
  </g>
</svg>
