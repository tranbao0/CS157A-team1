<%-- decorative art behind catalog's right column, sits inside sticky rail so it travels with search and cards --%>
<%-- blue disc with rings, stars and drifting dots like landing animation, dashed road runs down empty space under cards --%>
<svg class="rail-art" viewBox="0 0 404 1100" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="rail-disc" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#E4EDF8"/>
      <stop offset=".65" stop-color="#F1F6FB"/>
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="rail-glow">
      <stop offset="0" stop-color="#FDC23B" stop-opacity=".5"/>
      <stop offset="1" stop-color="#FDC23B" stop-opacity="0"/>
    </radialGradient>
    <%-- road fades in from behind cards instead of starting with hard end --%>
    <linearGradient id="rail-fade" gradientUnits="userSpaceOnUse" x1="0" y1="744" x2="0" y2="840">
      <stop offset="0" stop-color="#fff" stop-opacity="0"/>
      <stop offset="1" stop-color="#fff"/>
    </linearGradient>
    <mask id="rail-fade-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="404" height="1100">
      <rect width="404" height="1100" fill="url(#rail-fade)"/>
    </mask>
  </defs>

  <circle cx="196" cy="250" r="196" fill="url(#rail-disc)"/>
  <circle class="rail-art__ring" cx="196" cy="250" r="120"/>
  <circle class="rail-art__ring" cx="196" cy="250" r="168"/>

  <g class="art-motes">
    <circle class="art-mote art-mote--amber" cx="88" cy="170" r="3"/>
    <circle class="art-mote art-mote--blue art-mote--late" cx="300" cy="220" r="4"/>
    <circle class="art-mote art-mote--sjsu" cx="372" cy="134" r="3"/>
    <circle class="art-mote art-mote--blue" cx="22" cy="260" r="3"/>
    <circle class="art-mote art-mote--amber art-mote--late" cx="214" cy="390" r="3"/>
  </g>
  <g class="art-sparks">
    <g transform="translate(58 102) scale(.7)"><path class="art-spark" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
    <g transform="translate(332 48) scale(.9)"><path class="art-spark art-spark--2" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
    <g transform="translate(352 386) scale(.6)"><path class="art-spark art-spark--3" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
    <g transform="translate(40 340) scale(.5)"><path class="art-spark art-spark--4" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
    <g transform="translate(160 38) scale(.45)"><path class="art-spark art-spark--3" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
  </g>

  <%-- road below cards: one loop, open stop on left swing, small star at end --%>
  <g mask="url(#rail-fade-mask)">
    <path class="rail-art__road" d="M 258.0 558.8 C 258.0 567.2, 251.3 575.6, 239.8 584.1 C 228.4 592.5, 212.2 600.9, 196.0 609.4 C 179.8 617.8, 163.6 626.2, 152.2 634.7 C 140.7 643.1, 134.0 651.6, 134.0 660.0 C 134.0 668.4, 140.7 676.9, 152.2 685.3 C 163.6 693.8, 179.8 702.2, 196.0 710.6 C 212.2 719.1, 228.4 727.5, 239.8 735.9 C 251.3 744.4, 258.0 752.8, 258.0 761.2 C 258.0 769.7, 251.3 778.1, 239.8 786.6 C 228.4 795.0, 212.2 803.4, 196.0 811.9 C 179.8 820.3, 163.6 828.7, 152.1 837.1 C 140.5 845.5, 133.6 853.7, 133.1 862.5 C 132.7 871.3, 138.4 880.7, 149.5 894.8 C 160.5 909.0, 176.9 929.5, 196.0 952.3 C 215.1 975.0, 237.2 998.0, 254.7 1001.5 C 272.2 1004.9, 284.0 986.0, 284.0 963.8 C 284.0 941.5, 272.2 922.6, 254.7 926.0 C 237.2 929.5, 215.1 952.5, 196.0 975.2 C 176.9 998.0, 160.5 1018.5, 149.5 1032.7 C 138.4 1046.8, 132.7 1056.2, 133.1 1065.0"/>
  </g>
  <circle class="rail-art__todo" cx="133.1" cy="862.5" r="9"/>
  <g transform="translate(133.1 1065)">
    <circle class="rail-art__goal-glow" r="40" fill="url(#rail-glow)"/>
    <path class="rail-art__goal" d="M 0 -12 Q 2 -2 12 0 Q 2 2 0 12 Q -2 2 -12 0 Q -2 -2 0 -12 Z"/>
  </g>
</svg>
