  <%-- open stops show from start like landing, gold checks pop on top as dot reaches each one --%>
  <g class="road__todo">
    <circle cx="150" cy="656.9" r="10"/>
    <circle cx="300" cy="593.9" r="10"/>
    <circle cx="430" cy="544.2" r="10"/>
    <circle cx="1010" cy="282.5" r="10"/>
  </g>

  <g class="road__labels">
    <text x="150" y="632" text-anchor="middle">CS 46A</text>
    <text x="300" y="569" text-anchor="middle">CS 46B</text>
    <text x="430" y="519" text-anchor="middle">CS 146</text>
    <text class="road__now" x="1010" y="250" text-anchor="middle">CS 157A</text>
  </g>

