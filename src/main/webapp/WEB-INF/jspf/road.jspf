<%-- decorative backdrop for sign-in, sign-up and plan pages, same road as landing animation --%>
<%-- on load dot hops past three finished courses (round first loop), runs behind form card and stops on CS 157A, this class --%>
<%-- road ahead stays dashed, round second loop up to gold star --%>
<%-- road is wave with check on every crest and two loops in troughs, path points come from sampled curve, so edit shape as whole --%>
<svg class="road" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="road-disc" cx="50%" cy="50%" r="50%">
      <stop class="road__stop--core" offset="0"/>
      <stop class="road__stop--mid" offset=".65"/>
      <stop class="road__stop--edge" offset="1"/>
    </radialGradient>
    <%-- gold ends are one-off tints, not tokens, so they stay literal --%>
    <linearGradient id="road-gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFD866"/>
      <stop class="road__stop--amber" offset=".5"/>
      <stop offset="1" stop-color="#F2B530"/>
    </linearGradient>
    <radialGradient id="road-glow">
      <stop class="road__stop--glow-core" offset="0"/>
      <stop class="road__stop--glow-edge" offset="1"/>
    </radialGradient>
  </defs>

  <%-- disc sits on screen center, card is centered on screen too so it always lands in middle of rings --%>
  <g class="road__backdrop">
    <circle cx="720" cy="450" r="380" fill="url(#road-disc)"/>
    <circle class="road__ring" cx="720" cy="450" r="300"/>
    <circle class="road__ring" cx="720" cy="450" r="225"/>
    <%-- stars and drifting dots in disc, like landing animation, kept clear of road --%>
    <g class="art-motes">
      <circle class="art-mote art-mote--amber" cx="380" cy="520" r="4"/>
      <circle class="art-mote art-mote--blue art-mote--late" cx="1050" cy="420" r="5"/>
      <circle class="art-mote art-mote--sjsu" cx="560" cy="130" r="3"/>
      <circle class="art-mote art-mote--blue" cx="700" cy="850" r="4"/>
      <circle class="art-mote art-mote--amber art-mote--late" cx="905" cy="140" r="3"/>
      <circle class="art-mote art-mote--sjsu art-mote--late" cx="470" cy="790" r="3"/>
    </g>
    <g class="art-sparks">
      <g transform="translate(395 330)"><path class="art-spark" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
      <g transform="translate(470 720) scale(.7)"><path class="art-spark art-spark--2" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
      <g transform="translate(985 640) scale(.8)"><path class="art-spark art-spark--3" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
      <g transform="translate(850 160) scale(.6)"><path class="art-spark art-spark--4" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
      <g transform="translate(600 170) scale(.5)"><path class="art-spark art-spark--2" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
      <g transform="translate(930 760) scale(.55)"><path class="art-spark" d="M 0 -10 Q 1.6 -1.6 10 0 Q 1.6 1.6 0 10 Q -1.6 1.6 -10 0 Q -1.6 -1.6 0 -10 Z"/></g>
    </g>
  </g>

  <%-- whole road dashed, crest at (720, 422) runs behind see-through form card, so no stop there --%>
  <path class="road__path" d="M -75.0 836.3 C -68.8 833.7, -62.5 826.7, -56.2 816.7 C -50.0 806.7, -43.7 793.6, -37.5 780.5 C -31.3 767.5, -25.0 754.4, -18.8 744.4 C -12.5 734.4, -6.2 727.4, 0.0 724.8 C 6.2 722.2, 12.5 723.9, 18.8 728.6 C 25.0 733.4, 31.2 741.2, 37.5 749.0 C 43.8 756.9, 50.0 764.7, 56.3 769.5 C 62.5 774.2, 68.8 775.9, 75.0 773.3 C 81.2 770.7, 87.5 763.7, 93.7 753.7 C 100.0 743.7, 106.2 730.7, 112.4 717.5 C 118.6 704.4, 124.8 691.3, 130.8 680.7 C 136.9 670.0, 142.7 661.8, 150.0 656.9 C 157.3 652.1, 166.3 650.4, 181.1 654.2 C 195.8 658.1, 217.5 668.3, 238.1 686.1 C 258.8 703.8, 276.0 729.6, 274.2 751.2 C 272.3 772.7, 249.9 787.9, 225.0 785.3 C 200.1 782.7, 177.7 762.2, 175.8 735.4 C 174.0 708.6, 191.2 677.6, 211.9 654.5 C 232.5 631.5, 254.2 616.1, 268.9 607.0 C 283.7 597.9, 293.1 594.2, 300.0 593.9 C 306.9 593.7, 311.4 597.2, 316.7 603.0 C 321.9 608.7, 327.2 616.9, 332.6 625.1 C 337.9 633.4, 343.3 641.5, 348.8 646.6 C 354.2 651.7, 359.6 653.8, 365.0 651.5 C 370.4 649.2, 375.8 642.6, 381.2 633.0 C 386.7 623.3, 392.1 610.6, 397.5 597.8 C 402.9 585.1, 408.3 572.4, 413.7 562.7 C 419.2 553.1, 421.2 547.9, 430.0 544.2 C 438.8 540.5, 454.2 538.4, 466.3 540.7 C 478.3 543.0, 490.4 548.4, 502.5 553.8 C 514.6 559.1, 526.7 564.5, 538.8 566.8 C 550.8 569.1, 562.9 568.4, 575.0 563.3 C 587.1 558.2, 599.2 548.8, 611.3 536.4 C 623.3 523.9, 635.4 508.4, 647.5 492.8 C 659.6 477.3, 671.7 461.8, 683.7 449.3 C 695.8 436.9, 707.9 427.5, 720.0 422.4 C 732.1 417.3, 744.2 416.6, 756.3 418.9 C 768.3 421.2, 780.4 426.6, 792.5 432.0 C 804.6 437.3, 816.7 442.7, 828.8 445.0 C 840.8 447.3, 852.9 446.6, 865.0 441.5 C 877.1 436.5, 889.2 427.1, 901.2 414.7 C 913.3 402.3, 925.3 386.9, 937.1 371.0 C 949.0 355.2, 960.5 339.0, 972.1 323.9 C 983.7 308.8, 995.1 294.3, 1010.0 282.5 C 1024.9 270.6, 1044.2 261.2, 1071.5 263.0 C 1098.8 264.7, 1135.2 279.3, 1166.4 310.2 C 1197.6 341.0, 1220.3 388.3, 1217.8 427.7 C 1215.2 467.2, 1186.4 494.8, 1155.0 489.7 C 1123.6 484.6, 1094.8 446.9, 1092.2 397.3