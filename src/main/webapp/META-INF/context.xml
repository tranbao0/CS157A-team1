<?xml version="1.0" encoding="UTF-8"?>
<!--
  Manager with pathname writes open sessions to work/.../SESSIONS.ser when app stops and reads them back on start.
  CookieProcessor keeps session cookie off cross-site POSTs and still sends it when student follows a link from another site.
-->
<Context>
	<Manager pathname="SESSIONS.ser" />
	<CookieProcessor sameSiteCookies="lax" />
</Context>
